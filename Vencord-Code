@import url('https://plusinsta.github.io/discord-plus/src/DiscordPlus-source.theme.css');

.theme-dark {
  --dplus-backdrop: url('https://raw.githubusercontent.com/Snowyyx3i/Vencord-assets/main/Vencord.Background.gif');
  /* Image or color for the backdrop. Defaults to accent color on error. */
  
  

  /* next to pfp photo */
 [class*="panels_"] {
    background-image: url('https://github.com/Snowyyx3i/Vencord-assets/blob/main/Pfp.Background.gif?raw=truehttps://github.com/Snowyyx3i/Vencord-assets/blob/main/Pfp.Background.gif?raw=true') !important;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
